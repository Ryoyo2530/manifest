# Supabase project settings → API
# These are public browser values. Never use the service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Cloudflare Worker API origin (required for signed-in Wish generation)
VITE_MANIFEST_API_URL=https://YOUR-MANIFEST-API.workers.dev
